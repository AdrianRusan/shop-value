# ShopValue Environment Variables for Vercel Deployment
# =====================================================
# Add these environment variables to your Vercel project settings

# Required - Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shopvalue

# Required - Redis Cache (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Required - Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Required - Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Required - Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com

# Optional - Error Tracking (Sentry)
SENTRY_DSN=https://your_sentry_dsn@sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io

# Optional - Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# Application Settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com