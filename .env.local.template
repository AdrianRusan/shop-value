# StockWatch Configuration - Retail Arbitrage Price Tracking
# Copy this file to .env.local and fill in your actual values

# ================================
# DATABASE
# ================================
MONGODB_URI=mongodb+srv://[username]:[password]@cluster.mongodb.net/stockwatch?retryWrites=true&w=majority

# ================================
# AUTHENTICATION (Clerk)
# ================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ================================
# PAYMENTS (Stripe)
# ================================
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_ID_PRO=price_xxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxx

# ================================
# EMAIL (Resend)
# ================================
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@stockwatch.com

# ================================
# CACHING (Upstash Redis)
# ================================
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ================================
# WEB SCRAPING (BrightData Proxies)
# ================================
BRIGHTDATA_USERNAME=xxxxx
BRIGHTDATA_PASSWORD=xxxxx

# ================================
# MONITORING & ANALYTICS
# ================================
# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_AUTH_TOKEN=xxxxx

# Amplitude Analytics
NEXT_PUBLIC_AMPLITUDE_API_KEY=xxxxx

# ================================
# SECURITY
# ================================
# Secret for authenticating cron jobs (generate a random string)
CRON_SECRET=your-random-secret-here-min-32-chars

# ================================
# APPLICATION
# ================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next Auth (if needed for additional auth)
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
