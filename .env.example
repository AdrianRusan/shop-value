# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI/OpenRouter models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# ShopValue SaaS Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shopvalue?retryWrites=true&w=majority

# ==============================================
# AUTHENTICATION (CLERK)
# ==============================================
# Get these from: https://dashboard.clerk.dev/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==============================================
# PAYMENTS (STRIPE)
# ==============================================
# Get these from: https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Product/Price IDs (create these in Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# ==============================================
# CACHING (UPSTASH REDIS)
# ==============================================
# Get these from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ==============================================
# EMAIL SERVICE (RESEND)
# ==============================================
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# ==============================================
# ERROR TRACKING (SENTRY)
# ==============================================
# Get this from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxx

# ==============================================
# SCRAPING CONFIGURATION
# ==============================================
# BrightData proxy credentials
BRIGHTDATA_USERNAME=your_bright_data_username
BRIGHTDATA_PASSWORD=your_bright_data_password

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==============================================
# ANALYTICS (OPTIONAL)
# ==============================================
# Amplitude for user analytics
NEXT_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key_here

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================
# Rate limiting settings (requests per window)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60000

# ==============================================
# QUEUE CONFIGURATION
# ==============================================
# Redis URL for Bull queues (can be same as Upstash)
REDIS_URL=redis://localhost:6379

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# Secret for JWT tokens and general encryption
NEXTAUTH_SECRET=your_super_secret_jwt_key_min_32_characters
ENCRYPTION_KEY=your_32_character_encryption_key_here

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable/disable features during development
ENABLE_PRICE_ALERTS=true
ENABLE_API_ACCESS=true
ENABLE_ANALYTICS=true
ENABLE_REFERRALS=true

# ==============================================
# DEVELOPMENT CONFIGURATION
# ==============================================
# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Enable development features
DEV_MODE=true
DEBUG_SCRAPING=false
DEBUG_WEBHOOKS=false

# ============================================================================
# SHOPVALUE SAAS - ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================

# ============================================================================
# CLERK AUTHENTICATION (Required)
# ============================================================================
# Get these from: https://dashboard.clerk.dev/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk Webhook Secret (for user sync)
# Create webhook at: https://dashboard.clerk.dev/webhooks
# Webhook URL: https://your-domain.com/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted, session.created
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# DATABASE (Required)
# ============================================================================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shopvalue?retryWrites=true&w=majority

# ============================================================================
# STRIPE PAYMENTS (Required for production)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (for subscription sync)
# Create webhook at: https://dashboard.stripe.com/webhooks
# Webhook URL: https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Product/Price IDs (create these in Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# REDIS CACHE (Required)
# ============================================================================
# Get these from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ============================================================================
# EMAIL SERVICE (Required)
# ============================================================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@shopvalue.ro

# ============================================================================
# MONITORING & ANALYTICS (Recommended)
# ============================================================================
# Get DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Get API key from: https://app.amplitude.com/settings/projects
NEXT_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key_here

# ============================================================================
# SCRAPING SERVICE (Optional)
# ============================================================================
# Bright Data proxy credentials
BRIGHTDATA_USERNAME=your_bright_data_username
BRIGHTDATA_PASSWORD=your_bright_data_password

# ScrapingBee API key (optional, for anti-bot protection)
SCRAPING_BEE_API_KEY=your_scraping_bee_api_key_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application domain (used for webhooks and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support and admin emails
SUPPORT_EMAIL=support@shopvalue.ro
ADMIN_EMAIL=admin@shopvalue.ro

# ============================================================================
# RATE LIMITING & SECURITY
# ============================================================================
# Rate limiting settings (requests per minute)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# JWT secret for API authentication (auto-generated if not set)
JWT_SECRET=your_super_secret_jwt_key_here

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Set to 'development' for local development
NODE_ENV=development

# Enable debug logging (optional)
DEBUG=shopvalue:*

# Enable development features
DEV_MODE=true
DEBUG_SCRAPING=false
DEBUG_WEBHOOKS=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features during development
FEATURE_ENABLE_ANALYTICS=true
FEATURE_ENABLE_EMAIL_ALERTS=true
FEATURE_ENABLE_API_ACCESS=true

# ============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ============================================================================
# Google Analytics 4 Measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook Pixel ID (optional)
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345