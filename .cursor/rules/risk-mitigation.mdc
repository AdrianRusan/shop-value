# Risk Mitigation Rules for ShopValue

## **SCRAPING RESILIENCE (BUSINESS CRITICAL)**

### **Multi-Strategy Scraping (Single Point of Failure Prevention)**
```typescript
// ✅ DO: Implement multiple fallback scraping strategies
// lib/scraper/resilient-scraper.ts
import puppeteer from 'puppeteer';
import { chromium } from 'playwright';
import axios from 'axios';

export interface ScrapingStrategy {
  name: string;
  scrape: (url: string) => Promise<ScrapingResult | null>;
  timeout: number;
  reliability: number; // 0-1 score
}

export interface ScrapingResult {
  price: number;
  title: string;
  availability: 'in_stock' | 'out_of_stock' | 'limited';
  currency: string;
  confidence: number; // 0-1 score
  selector: string;
  scrapedAt: Date;
}

const strategies: ScrapingStrategy[] = [
  {
    name: 'puppeteer',
    scrape: scrapePuppeteer,
    timeout: 30000,
    reliability: 0.85
  },
  {
    name: 'playwright',
    scrape: scrapePlaywright,
    timeout: 25000,
    reliability: 0.90
  },
  {
    name: 'api_proxy',
    scrape: scrapeWithProxy,
    timeout: 15000,
    reliability: 0.70
  },
  {
    name: 'cached_fallback',
    scrape: getLastKnownPrice,
    timeout: 1000,
    reliability: 0.60
  }
];

export const scrapeWithFallbacks = async (product: Product): Promise<ScrapingResult | null> => {
  for (const strategy of strategies) {
    try {
      console.log(`Attempting ${strategy.name} for ${product.url}`);
      
      const result = await Promise.race([
        strategy.scrape(product.url),
        new Promise<null>((_, reject) => 
          setTimeout(() => reject(new Error('Timeout')), strategy.timeout)
        )
      ]);
      
      if (result && result.price > 0) {
        // Track successful strategy
        await redis.incr(`scraping:success:${strategy.name}`);
        
        // Update product selector if different
        if (result.selector !== product.scraping?.selector) {
          await Product.findByIdAndUpdate(product._id, {
            'scraping.selector': result.selector,
            'scraping.lastSuccessful': new Date(),
            'scraping.failureCount': 0
          });
        }
        
        console.log(`✅ ${strategy.name} succeeded for ${product.url}: €${result.price}`);
        return result;
      }
      
    } catch (error) {
      console.error(`❌ ${strategy.name} failed for ${product.url}:`, error.message);
      
      // Track failed strategy
      await redis.incr(`scraping:failure:${strategy.name}`);
      
      // Continue to next strategy
      continue;
    }
  }
  
  // All strategies failed
  await Product.findByIdAndUpdate(product._id, {
    'scraping.failureCount': { $inc: 1 },
    'scraping.lastFailedAt': new Date()
  });
  
  console.error(`🚨 All scraping strategies failed for ${product.url}`);
  return null;
};

// ❌ DON'T: Rely on single scraping method
const scrapePrice = async (url: string) => {
  return await puppeteer.scrape(url); // Single point of failure
};
```

### **Intelligent Retry Logic with Exponential Backoff**
```typescript
// ✅ DO: Implement smart retry with backoff and circuit breaker
export const scrapeWithRetry = async (
  product: Product, 
  maxRetries: number = 3
): Promise<ScrapingResult | null> => {
  
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      const result = await scrapeWithFallbacks(product);
      
      if (result) {
        // Reset failure count on success
        if (product.scraping?.failureCount > 0) {
          await Product.findByIdAndUpdate(product._id, {
            'scraping.failureCount': 0,
            'scraping.isBlocked': false
          });
        }
        return result;
      }
      
    } catch (error) {
      const delay = Math.min(1000 * Math.pow(2, attempt), 30000); // Max 30s delay
      
      console.log(`Retry ${attempt}/${maxRetries} for ${product.url} in ${delay}ms`);
      
      if (attempt < maxRetries) {
        await new Promise(resolve => setTimeout(resolve, delay));
      }
    }
  }
  
  // Mark as potentially blocked after repeated failures
  const currentFailures = product.scraping?.failureCount || 0;
  if (currentFailures >= 5) {
    await Product.findByIdAndUpdate(product._id, {
      'scraping.isBlocked': true,
      'scraping.blockedAt': new Date()
    });
    
    // Alert admin
    await emailQueue.add('admin-alert', {
      type: 'scraping_blocked',
      productId: product._id,
      url: product.url,
      failureCount: currentFailures + 1
    }, { priority: 'high' });
  }
  
  return null;
};

// ❌ DON'T: Fail immediately without retries
const scrapeProduct = async (url: string) => {
  const result = await scrapePrice(url);
  if (!result) throw new Error('Scraping failed'); // No retry
};
