## **LEGAL & COMPLIANCE AUTOMATION**

### **Automated GDPR Compliance**
```typescript
// ✅ DO: Automate GDPR compliance workflows
export const handleGDPRRequest = async (type: 'export' | 'delete', userId: string) => {
  const request = new GDPRRequest({
    userId,
    type,
    status: 'pending',
    requestedAt: new Date(),
    ip: request.headers.get('x-forwarded-for'),
    userAgent: request.headers.get('user-agent')
  });
  
  await request.save();
  
  try {
    if (type === 'export') {
      const userData = await exportUserData(userId);
      
      // Send via secure email
      await emailQueue.add('gdpr-export', {
        userId,
        data: userData,
        requestId: request._id
      }, { 
        priority: 'high',
        delay: 0 
      });
      
      await GDPRRequest.findByIdAndUpdate(request._id, {
        status: 'completed',
        completedAt: new Date()
      });
      
    } else if (type === 'delete') {
      // 30-day deletion delay for business continuity
      await emailQueue.add('gdpr-deletion', {
        userId,
        requestId: request._id
      }, { 
        delay: 30 * 24 * 60 * 60 * 1000 // 30 days
      });
      
      await GDPRRequest.findByIdAndUpdate(request._id, {
        status: 'scheduled',
        scheduledFor: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
      });
    }
    
  } catch (error) {
    await GDPRRequest.findByIdAndUpdate(request._id, {
      status: 'failed',
      error: error.message
    });
    throw error;
  }
};

