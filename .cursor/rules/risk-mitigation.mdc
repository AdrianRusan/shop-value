    await emailQueue.add('admin-alert', {
      type: 'low_scraping_success',
      rate: metrics.scrapingSuccessRate,
      severity: 'high'
    }, { priority: 'high' });
  }
  
  // Alert if no revenue in 24 hours
  if (metrics.dailyRevenue === 0) {
    await emailQueue.add('admin-alert', {
      type: 'no_revenue_24h',
      severity: 'critical'
    }, { priority: 'high' });
  }
  
  // Alert if error rate exceeds 5%
  if (metrics.errorRate > 0.05) {
    await emailQueue.add('admin-alert', {
      type: 'high_error_rate',
      rate: metrics.errorRate,
      severity: 'medium'
    }, { priority: 'normal' });
  }
  
  // Store metrics for trending
  await redis.set(`metrics:health:${Date.now()}`, JSON.stringify(metrics), 'EX', 86400);
};

