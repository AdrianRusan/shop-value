  supportedRetailers: string[];
  priceSelectors: Record<string, string[]>;
  language: string;
  vatRate: number;
}

export const MARKET_CONFIGS: Record<string, MarketConfig> = {
  RO: {
    countryCode: 'RO',
    currency: 'RON',
    supportedRetailers: ['flip.ro', 'emag.ro', 'altex.ro'],
    priceSelectors: {
      'flip.ro': ['.price-current', '.price', '[data-price]'],
      'emag.ro': ['.product-new-price', '.price', '.current-price'],
      'altex.ro': ['.price-new', '.price', '.final-price']
    },
    language: 'ro',
    vatRate: 0.19
  },
  // Future expansion ready
  BG: {
    countryCode: 'BG',
    currency: 'BGN',
    supportedRetailers: ['emag.bg', 'technomarket.bg'],
    priceSelectors: {
      'emag.bg': ['.product-new-price', '.price'],
      'technomarket.bg': ['.price', '.current-price']
    },
    language: 'bg',
    vatRate: 0.20
  }
};

export const getMarketConfig = (url: string): MarketConfig => {
  // Detect market from URL
  for (const [countryCode, config] of Object.entries(MARKET_CONFIGS)) {
    const retailer = config.supportedRetailers.find(r => url.includes(r));
    if (retailer) {
      return config;
    }
  }
  
  // Default to Romania
  return MARKET_CONFIGS.RO;
};

