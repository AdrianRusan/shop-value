### **Automated Data Export (GDPR & Business Continuity)**
```typescript
// ✅ DO: Implement automated data export and backup
// app/api/admin/export/route.ts
export async function POST(request: Request) {
  try {
    const { type, userId } = await request.json();
    
    if (type === 'user_data' && userId) {
      // GDPR data export
      const userData = await exportUserData(userId);
      return Response.json({ success: true, data: userData });
    }
    
    if (type === 'full_backup') {
      // Admin only - full system backup
      const user = await requireAuth();
      if (user.role !== 'admin') {
        return Response.json({ error: 'Unauthorized' }, { status: 403 });
      }
      
      const backupData = await createFullBackup();
      return Response.json({ success: true, backupId: backupData.id });
    }
    
  } catch (error) {
    Sentry.captureException(error);
    return Response.json({ error: 'Export failed' }, { status: 500 });
  }
}

const exportUserData = async (userId: string) => {
  const user = await User.findOne({ clerkId: userId }).lean();
  const trackedProducts = await UserProductTracking.find({ userId }).lean();
  const productIds = trackedProducts.map(t => t.productId);
  const products = await Product.find({ _id: { $in: productIds } }).lean();
  const priceHistory = await PriceHistory.find({ 
    productId: { $in: productIds } 
  }).lean();
  
  return {
    exportDate: new Date().toISOString(),
    user: {
      ...user,
      _id: undefined, // Remove internal ID
      stripeCustomerId: undefined, // Remove sensitive data
    },
    trackedProducts,
    products: products.map(p => ({
      ...p,
      _id: undefined,
      scraping: undefined // Remove internal scraping data
    })),
    priceHistory: priceHistory.map(h => ({
      price: h.price,
      timestamp: h.timestamp,
      productUrl: products.find(p => p._id.equals(h.productId))?.url
    }))
  };
};

