### **Price History Preservation**
```typescript
// ✅ DO: Maintain price history even when products are removed
export const archiveProductData = async (productId: string) => {
  try {
    const product = await Product.findById(productId);
    const priceHistory = await PriceHistory.find({ productId }).lean();
    
    if (!product) return;
    
    // Create archive record
    const archive = new ProductArchive({
      originalId: productId,
      url: product.url,
      title: product.title,
      brand: product.brand,
      archivedAt: new Date(),
      finalPrice: product.currentPrice,
      priceHistory: priceHistory.map(h => ({
        price: h.price,
        timestamp: h.timestamp
      })),
      reason: 'no_active_trackers'
    });
    
    await archive.save();
    
    // Now safe to remove from active collections
    await Product.findByIdAndDelete(productId);
    await PriceHistory.deleteMany({ productId });
    
    console.log(`Archived product data for ${product.url}`);
    
  } catch (error) {
    Sentry.captureException(error);
    console.error('Error archiving product data:', error);
  }
};

// ❌ DON'T: Delete price history without archiving
const removeProduct = async (productId: string) => {
  await Product.findByIdAndDelete(productId);
  await PriceHistory.deleteMany({ productId }); // Lost forever
};
