### **Payment Failed Handler (Retention Critical)**
```typescript
// ✅ DO: Handle payment failures with customer communication
const handlePaymentFailed = async (invoice: any) => {
  try {
    const subscription = await stripe.subscriptions.retrieve(invoice.subscription);
    const customer = await stripe.customers.retrieve(subscription.customer);
    const userId = subscription.metadata.userId;
    
    if (!userId) {
      console.error('No userId in subscription metadata');
      return;
    }
    
    // Update user status
    await User.findOneAndUpdate(
      { clerkId: userId },
      {
        subscriptionStatus: 'past_due',
        paymentIssue: {
          hasIssue: true,
          lastFailedAt: new Date(),
          attemptCount: (await User.findOne({ clerkId: userId }))?.paymentIssue?.attemptCount + 1 || 1
        }
      }
    );
    
    // Track business event
    await trackBusinessEvent('payment_failed', userId, {
      subscription_id: subscription.id,
      amount: invoice.amount_due,
      attempt_count: invoice.attempt_count,
      next_payment_attempt: invoice.next_payment_attempt 
        ? new Date(invoice.next_payment_attempt * 1000) 
        : null,
      timestamp: new Date().toISOString()
    });
    
    // Send payment failure notification
    await emailQueue.add('payment-failed', {
      userId,
      email: customer.email,
      amount: invoice.amount_due,
      currency: invoice.currency,
      retryDate: invoice.next_payment_attempt 
        ? new Date(invoice.next_payment_attempt * 1000) 
        : null,
      updatePaymentUrl: `${process.env.NEXT_PUBLIC_APP_URL}/billing`
    }, {
      priority: 'high' // High priority for retention
    });
    
    console.log(`Payment failed for user ${userId}, attempt ${invoice.attempt_count}`);
    
  } catch (error) {
    Sentry.captureException(error);
    console.error('Error handling payment failure:', error);
  }
};

// ❌ DON'T: Ignore payment failures or skip customer communication
```

### **Subscription Cancelled Handler**
```typescript
// ✅ DO: Handle cancellation with retention attempt
const handleSubscriptionDeleted = async (subscription: any) => {
  try {
    const userId = subscription.metadata.userId;
    
    if (!userId) {
      console.error('No userId in subscription metadata');
      return;
    }
    
    const user = await User.findOneAndUpdate(
      { clerkId: userId },
      {
        subscriptionTier: 'free',
        subscriptionStatus: 'canceled',
        subscriptionEndDate: new Date(),
        canceledAt: new Date()
      },
      { new: true }
    );
    
    // Track churn event
    await trackBusinessEvent('subscription_canceled', userId, {
      plan: user.subscriptionTier,
      billing_cycle: user.billingCycle,
      time_to_churn: Date.now() - user.subscriptionStartDate?.getTime(),
      reason: subscription.cancellation_details?.reason || 'unknown',
      timestamp: new Date().toISOString()
    });
    
    // Update MRR metrics
    const plan = SUBSCRIPTION_PLANS[user.subscriptionTier];
    const monthlyAmount = user.billingCycle === 'yearly' 
      ? plan?.amountYearly / 12 
      : plan?.amountMonthly;
    
    if (monthlyAmount) {
      await redis.decrby('metrics:mrr:current', monthlyAmount);
      await redis.incr('metrics:churn:monthly');
    }
    
    // Send cancellation confirmation and win-back email
    await emailQueue.add('subscription-canceled', {
      userId,
      email: user.email,
      feedback_url: `${process.env.NEXT_PUBLIC_APP_URL}/feedback?reason=cancellation`,
      winback_offer: {
        discount: 20, // 20% off for 3 months
        expires: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000) // 30 days
      }
    });
    
    console.log(`Subscription canceled for user ${userId}`);
    
  } catch (error) {
    Sentry.captureException(error);
    console.error('Error handling subscription cancellation:', error);
  }
};

