### **Checkout Session Creation**
```typescript
// ✅ DO: Create secure checkout with proper success handling
// app/api/checkout/route.ts
import { stripe } from '@/lib/stripe';
import { requireAuth } from '@/lib/auth';
import { User } from '@/lib/models/user.model';

export async function POST(request: Request) {
  try {
    const user = await requireAuth();
    const { planId, billing } = await request.json();
    
    if (!['pro', 'enterprise'].includes(planId)) {
      return Response.json({ error: 'Invalid plan' }, { status: 400 });
    }
    
    if (!['monthly', 'yearly'].includes(billing)) {
      return Response.json({ error: 'Invalid billing cycle' }, { status: 400 });
    }
    
    const plan = SUBSCRIPTION_PLANS[planId];
    const priceId = billing === 'monthly' ? plan.priceIdMonthly : plan.priceIdYearly;
    
    // Create or retrieve Stripe customer
    let stripeCustomerId = user.stripeCustomerId;
    if (!stripeCustomerId) {
      const customer = await stripe.customers.create({
        email: user.email,
        name: `${user.firstName} ${user.lastName}`,
        metadata: {
          clerkId: user.clerkId,
          userId: user._id.toString()
        }
      });
      
      stripeCustomerId = customer.id;
      await User.findOneAndUpdate(
        { clerkId: user.clerkId },
        { stripeCustomerId }
      );
    }
    
    // Create checkout session
    const session = await stripe.checkout.sessions.create({
      customer: stripeCustomerId,
      payment_method_types: ['card'],
      line_items: [
        {
          price: priceId,
          quantity: 1,
        },
      ],
      mode: 'subscription',
      success_url: `${process.env.NEXT_PUBLIC_APP_URL}/dashboard?session_id={CHECKOUT_SESSION_ID}&success=true`,
      cancel_url: `${process.env.NEXT_PUBLIC_APP_URL}/pricing?canceled=true`,
      metadata: {
        userId: user.clerkId,
        planId,
        billing
      },
      subscription_data: {
        metadata: {
          userId: user.clerkId,
          planId,
          billing
        }
      },
      customer_update: {
        address: 'auto',
        name: 'auto'
      },
      tax_id_collection: {
        enabled: true // Important for EU VAT compliance
      },
      automatic_tax: {
        enabled: true
      }
    });
    
    return Response.json({ url: session.url });
    
  } catch (error) {
    Sentry.captureException(error);
    console.error('Checkout session creation failed:', error);
    return Response.json({ error: 'Internal server error' }, { status: 500 });
  }
}

