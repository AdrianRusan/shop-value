### **Revenue Analytics Integration**
```typescript
// ✅ DO: Track all revenue metrics
export const updateMRRMetrics = async (event: string, subscription: any) => {
  const planId = subscription.metadata.planId;
  const billing = subscription.metadata.billing;
  const plan = SUBSCRIPTION_PLANS[planId];
  
  if (!plan) return;
  
  const monthlyAmount = billing === 'yearly' 
    ? (billing === 'yearly' ? plan.amountYearly / 12 : plan.amountMonthly)
    : plan.amountMonthly;
  
  switch (event) {
    case 'subscription_started':
      await redis.incrby('metrics:mrr:current', monthlyAmount);
      await redis.incr(`metrics:new_subscribers:${planId}`);
      break;
    case 'subscription_canceled':
      await redis.decrby('metrics:mrr:current', monthlyAmount);
      await redis.incr(`metrics:churn:${planId}`);
      break;
    case 'subscription_upgraded':
      // Handle upgrade from old plan to new plan
      const oldMonthlyAmount = subscription.metadata.oldMonthlyAmount;
      await redis.decrby('metrics:mrr:current', oldMonthlyAmount);
      await redis.incrby('metrics:mrr:current', monthlyAmount);
      await redis.incr('metrics:upgrades');
      break;
  }
  
  // Update daily metrics
  const today = new Date().toISOString().split('T')[0];
  await redis.incrby(`metrics:mrr:daily:${today}`, 
    event === 'subscription_canceled' ? -monthlyAmount : monthlyAmount
  );
};

