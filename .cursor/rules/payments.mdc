## **SUBSCRIPTION MANAGEMENT**

### **Usage Limit Enforcement**
```typescript
// ✅ DO: Enforce subscription limits consistently
export const checkSubscriptionLimits = async (userId: string, action: 'add_product' | 'api_call') => {
  const user = await User.findOne({ clerkId: userId });
  
  if (!user) {
    throw new Error('User not found');
  }
  
  const plan = SUBSCRIPTION_PLANS[user.subscriptionTier];
  
  if (action === 'add_product') {
    const currentCount = await UserProductTracking.countDocuments({ 
      userId, 
      isActive: true 
    });
    
    if (currentCount >= plan.maxProducts) {
      throw new Error(`Product limit reached. Upgrade to add more products. Current: ${currentCount}/${plan.maxProducts}`);
    }
  }
  
  // Check trial expiration for free users
  if (user.subscriptionTier === 'free' && user.trialEndDate && new Date() > user.trialEndDate) {
    throw new Error('Free trial expired. Please upgrade to continue.');
  }
  
  return true;
};

// ❌ DON'T: Allow unlimited usage without checks
const addProduct = async (userId: string, productUrl: string) => {
  // Add without checking limits
  await UserProductTracking.create({ userId, productUrl });
};
