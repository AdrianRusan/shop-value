// ✅ DO: Support A/B testing for pricing
export const getPricingForUser = async (userId: string) => {
  const user = await User.findOne({ clerkId: userId });
  
  // Default pricing
  let pricing = SUBSCRIPTION_PLANS;
  
  // A/B test pricing (example: 10% discount test)
  if (user?.metadata?.pricingTest === 'discount_10') {
    pricing = {
      ...SUBSCRIPTION_PLANS,
      pro: {
        ...SUBSCRIPTION_PLANS.pro,
        amountMonthly: Math.round(SUBSCRIPTION_PLANS.pro.amountMonthly * 0.9),
        amountYearly: Math.round(SUBSCRIPTION_PLANS.pro.amountYearly * 0.9)
      }
    };
  }
  
  return pricing;
};

