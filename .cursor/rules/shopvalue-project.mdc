## **BUSINESS LOGIC REQUIREMENTS**

### **Subscription Tier Enforcement**
```typescript
// ✅ DO: Enforce subscription limits consistently
const checkSubscriptionLimits = async (userId: string, action: 'add_product' | 'set_alert') => {
  const user = await User.findOne({ clerkId: userId });
  const usage = await UserProductTracking.countDocuments({ userId, isActive: true });
  
  const limits = {
    free: { maxProducts: 5, features: ['basic_alerts'] },
    pro: { maxProducts: 50, features: ['advanced_alerts', 'price_history'] },
    enterprise: { maxProducts: Infinity, features: ['api_access', 'priority_support'] }
  };
  
  const userLimits = limits[user.subscriptionTier];
  
  if (action === 'add_product' && usage >= userLimits.maxProducts) {
    throw new Error('Subscription limit reached. Please upgrade.');
  }
  
  return true;
};

// ❌ DON'T: Skip subscription limit checks
const addProduct = async (userId: string, productUrl: string) => {
  // Add product without checking limits
  await UserProductTracking.create({ userId, productUrl });
};
```

### **Price Alert Logic**
```typescript
// ✅ DO: Implement smart price alert logic
const processPriceAlert = async (product: Product, newPrice: number) => {
  const priceChange = ((newPrice - product.currentPrice) / product.currentPrice) * 100;
  
  if (priceChange <= -5) { // 5% or more price drop
    const trackers = await UserProductTracking.find({
      productId: product._id,
      isActive: true,
      'priceAlert.enabled': true,
      $or: [
        { 'priceAlert.thresholdType': 'percentage', 'priceAlert.threshold': { $gte: Math.abs(priceChange) } },
        { 'priceAlert.thresholdType': 'fixed', 'priceAlert.threshold': { $gte: newPrice } }
      ]
    });
    
    for (const tracker of trackers) {
      await emailQueue.add('price-alert', {
        userId: tracker.userId,
        productId: product._id,
        oldPrice: product.currentPrice,
        newPrice,
        priceChange
      });
    }
  }
};

// ❌ DON'T: Send alerts without proper threshold checking
```

