### **Caching Implementation**
```typescript
// ✅ DO: Implement caching for all GET endpoints
import { redis } from '@/lib/upstash';

export async function GET(request: Request) {
  const cacheKey = `products:${searchTerm}`;
  
  // Try cache first
  const cached = await redis.get(cacheKey);
  if (cached) {
    return Response.json({ 
      success: true, 
      data: cached, 
      cached: true 
    });
  }
  
  // Fetch and cache
  const data = await fetchProducts(searchTerm);
  await redis.setex(cacheKey, 3600, data);
  
  return Response.json({ success: true, data, cached: false });
}

// ❌ DON'T: Skip caching for expensive operations
