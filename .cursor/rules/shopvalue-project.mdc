## **RISK MITIGATION REQUIREMENTS**

### **Scraping Resilience**
```typescript
// ✅ DO: Implement multiple fallback strategies
const scrapePriceWithFallbacks = async (product: Product): Promise<number | null> => {
  const strategies = [
    () => scrapeWithPuppeteer(product.url),
    () => scrapeWithPlaywright(product.url),
    () => scrapeWithAPI(product.url),
    () => getLastKnownPrice(product._id)
  ];
  
  for (const strategy of strategies) {
    try {
      const price = await strategy();
      if (price && price > 0) {
        return price;
      }
    } catch (error) {
      Sentry.captureException(error);
      continue; // Try next strategy
    }
  }
  
  return null; // All strategies failed
};

// ❌ DON'T: Rely on single scraping method
const scrapePrice = async (url: string) => {
  return await puppeteer.scrape(url); // Single point of failure
};
```

